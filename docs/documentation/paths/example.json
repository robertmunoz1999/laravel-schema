                            ],
                            "properties": {
                                "data": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "../resources/example.json"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "400": {
                "description": "Invalid parameters",
